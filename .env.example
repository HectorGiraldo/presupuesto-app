# Copia este archivo a .env y ajusta los valores.

# --- Base de datos ---
DB_USER=presupuesto
DB_PASSWORD=cambia-esta-contrasena
DB_NAME=presupuesto
# Alternativa a las 4 variables de arriba: una URL completa (la usan Coolify/Docker si la define).
# DATABASE_URL=postgres://usuario:contrasena@host:5432/basededatos

# --- API ---
PORT=3000
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=30d
# El primer usuario siempre puede registrarse. A partir de ahí, controla si se admiten más.
ALLOW_REGISTRATION=true
# Dominios permitidos a llamar a la API (en Coolify, con nginx sirviendo todo en un dominio, no hace falta tocarlo).
CORS_ORIGINS=http://localhost:4200
